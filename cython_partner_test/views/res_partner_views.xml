<odoo>
    <record id="view_partner_form_cython_demo" model="ir.ui.view">
        <field name="name">res.partner.form.cython.demo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Cython Demo">
                    <field name="demo_amount"/>
                    <field name="protected_result" readonly="1"/>
                    <button name="action_run_hidden_logic"
                            type="object"
                            string="Run Hidden Logic"
                            class="btn-primary"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>